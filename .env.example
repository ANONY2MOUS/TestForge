# GitHub Personal Access Token (optional but recommended)
GITHUB_API_TOKEN=

# GitHub API base URL (override for GitHub Enterprise)
GITHUB_API_BASE_URL=https://api.github.com

# Base URL for E2E tests
E2E_BASE_URL=https://github.com

# API client settings
API_TIMEOUT_SECONDS=30
API_MAX_RETRIES=3

# Test report output paths
E2E_JSON_REPORT_PATH=test-results/e2e-report.json
API_JSON_REPORT_PATH=test-results/api-report.json
COMBINED_REPORT_OUTPUT=reports/combined-test-report.html
